# ตัวอย่างค่าตั้งต้น — copy เป็น .env แล้วแก้ค่า
# SIGN_API_KEY ฟรีจาก https://www.eulerstream.com (ต้องใช้ต่อ TikTok LIVE จริง)
SIGN_API_KEY=

# @username ของช่องที่กำลัง LIVE (ไม่ต้องใส่ @ ก็ได้)
TIKTOK_USERNAME=

# ข้อมูลโฮสต์ (ถ้าไม่กรอก จะดึงจาก TikTok อัตโนมัติตอนเชื่อมต่อ)
HOST_NAME=tiktokgameee
HOST_AVATAR=/assets/host-avatar.svg

PORT=3000
